<Project Sdk="Microsoft.NET.Sdk">

  <!--
    De-identifies a FHIR R4 bundle under Safe Harbor, or pseudonymized with a key from an
    environment variable. In your own project: dotnet add package DeidSharp.Fhir
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <None Include="patient-bundle.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DeidSharp.Fhir\DeidSharp.Fhir.csproj" />
  </ItemGroup>

</Project>
