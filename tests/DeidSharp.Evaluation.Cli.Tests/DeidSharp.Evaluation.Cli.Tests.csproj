<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- xUnit v3 test projects are executables. -->
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- `dotnet test` runs on Microsoft.Testing.Platform (global.json); the Test SDK and
       VSTest adapter stay so IDE test explorers that still use VSTest can discover tests. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\tools\DeidSharp.Evaluation.Cli\DeidSharp.Evaluation.Cli.csproj" />
  </ItemGroup>

</Project>
