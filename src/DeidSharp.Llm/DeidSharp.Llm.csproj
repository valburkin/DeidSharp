<Project Sdk="Microsoft.NET.Sdk">

  <!-- A DeidSharp detector that asks a language model, through Microsoft.Extensions.AI's IChatClient. -->
  <PropertyGroup>
    <Description>LLM detector for DeidSharp: finds PHI in free text by asking a language model through Microsoft.Extensions.AI's IChatClient, meant for a model running locally (Ollama, vLLM, LM Studio).</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Data\example-pool.json" LogicalName="DeidSharp.Llm.Data.example-pool.json" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\assets\icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DeidSharp\DeidSharp.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DeidSharp.Tests" />
  </ItemGroup>

</Project>
