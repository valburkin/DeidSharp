# The model baselines' packages. Edit this file, then regenerate the lock:
#   uv pip compile requirements.in --generate-hashes --emit-index-url --exclude-newer-package hf-xet=2026-10-29 --python-version 3.12 --python-platform x86_64-unknown-linux-gnu --index-url https://pypi.org/simple --extra-index-url https://download.pytorch.org/whl/cu130 --index-strategy unsafe-best-match --output-file requirements.txt
# hf-xet is held at the release the lock was first built with: a newer one came out the day the
# lock moved to CUDA, and only PyTorch's build was to change. Drop the hold at the next update.
# The image installs exactly the locked set. opf (OpenAI Privacy Filter's package) is not on
# PyPI; the Dockerfile adds its source at a pinned commit, and its dependencies are here.
# PyTorch's CUDA 13.0 build, from PyTorch's own index: it runs on NVIDIA's Blackwell cards (RTX 50xx)
# and older ones back to Turing.
torch==2.14.1+cu130
# gliner 0.2.29 needs transformers below 5.17.
transformers==5.16.1
gliner==0.2.29
huggingface_hub
safetensors
numpy
tiktoken
packaging
sentencepiece
# transformers reads a SentencePiece tokenizer (GLiNER's encoder's) through protobuf; without it,
# it falls back to a converter that can't read the file.
protobuf
